# Battle Arena Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

NODE_ENV=development

# Database (PostgreSQL connection URL)
# Local dev: postgresql://user:password@localhost:5432/battlearena
# Production: set on the VPS
DATABASE_URL=postgresql://user:password@localhost:5432/battlearena

# Redis connection URL
# Local dev: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Authentication secret (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Application URL
APP_URL=http://localhost:3000

# AI provider: mock | ollama | llama-cpp
AI_PROVIDER=mock

# Remote AI server URL (ONLY used server-side, never exposed to the browser)
AI_BASE_URL=
AI_MODEL=

# AI request timeout in milliseconds
AI_TIMEOUT=120000

# Maximum concurrent AI requests
AI_MAX_CONCURRENCY=2

# File storage path
STORAGE_PATH=./storage

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Simulation engine version (bumped when rules change)
SIMULATION_ENGINE_VERSION=0.1.0

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_MAX_AGE_DAYS=30

# Battle queue
BATTLE_QUEUE_CONCURRENCY=2
BATTLE_QUEUE_MAX_PER_USER=3