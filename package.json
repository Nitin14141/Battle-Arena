{
  "name": "battle-arena",
  "version": "0.1.0",
  "description": "Battle Arena - AI-powered character battle analysis platform",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter battle-arena-web dev",
    "build": "pnpm --filter battle-arena-web build",
    "start": "pnpm --filter battle-arena-web start",
    "lint": "pnpm --filter battle-arena-web lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "check": "pnpm -r check",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/client": "6.0.0",
    "zod": "^3.25.76"
  }
}